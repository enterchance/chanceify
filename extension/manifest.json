{
  "manifest_version": 3,
  "name": "chanceify for Last.fm",
  "version": "1.0.0",
  "description": "Play any song on Last.fm in chanceify with one click.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.last.fm/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "chanceify", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "browser_specific_settings": {
    "gecko": {
      "id": "lastfm@chanceify.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
